{
  "manifest_version": 3,
  "name": "Auto Tab Groups",
  "version": "1.0.0",
  "description": "Automatically groups open tabs by domain name",
  "permissions": ["tabs", "tabGroups"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Command+Shift+E"
      },
      "description": "Open the Auto Tab Groups popup"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Auto Tab Groups",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
