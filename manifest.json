{
  "manifest_version": 3,
  "name": "Grouple",
  "version": "1.0.0",
  "description": "Automatically groups open tabs by domain name",
  "permissions": ["tabs", "tabGroups", "storage", "contextMenus"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+G",
        "mac": "Command+Shift+E"
      },
      "description": "Open the Grouple popup"
    },
    "fold-all-groups": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "MacCtrl+Shift+Comma"
      },
      "description": "Fold (collapse) all tab groups in the current window"
    },
    "unfold-all-groups": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "MacCtrl+Shift+Period"
      },
      "description": "Unfold (expand) all tab groups in the current window"
    },
    "focus-active-group": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "mac": "MacCtrl+Shift+G"
      },
      "description": "Unfold the active tab's group and fold all others"
    },
    "toggle-tab-work-group": {
      "description": "Add the current tab to the manual group (or take it out)"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grouple",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
